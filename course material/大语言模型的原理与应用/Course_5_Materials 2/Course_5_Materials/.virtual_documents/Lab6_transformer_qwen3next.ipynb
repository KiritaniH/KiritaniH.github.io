import math
import torch

def scaled_dot_product_attention(Q, K, V, mask=None):
    """标准缩放点积注意力。

    Q:    [B, Q, d] 或 [B, h, Q, d]
    K:    [B, T, d] 或 [B, h, T, d]
    V:    [B, T, dv] 或 [B, h, T, dv]
    mask: [T, T] 或 [B, h, T, T]
    """
    scores = (Q @ K.transpose(-1, -2)) / math.sqrt(Q.shape[-1])

    # 如果 mask 是 [T, T]，这里利用广播把它加到每个 batch / 每个头上
    if mask is not None:
        scores = scores + mask

    weights = torch.softmax(scores, dim=-1)
    output = weights @ V
    return output, weights


