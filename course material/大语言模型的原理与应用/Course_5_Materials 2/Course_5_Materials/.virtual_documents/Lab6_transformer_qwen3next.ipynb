    use_moe=True,                      # 现在默认打开 MoE 训练
    mtp_loss_weights=[1.0, 0.6, 0.4],
)

input_ids, labels, answer_mask, _ = make_batch(batch_size=8, max_digits=6)
logits_list, loss = model(input_ids, labels, answer_mask)
