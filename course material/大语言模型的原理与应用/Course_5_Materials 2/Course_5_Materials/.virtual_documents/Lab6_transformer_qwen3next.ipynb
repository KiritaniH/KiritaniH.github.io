import torch
import torch.nn as nn


class SingleHeadSelfAttention(nn.Module):
    def __init__(self, hidden_size, head_dim):
        super().__init__()
        self.q_proj = nn.Linear(hidden_size, head_dim, bias=False)
        self.k_proj = nn.Linear(hidden_size, head_dim, bias=False)
        self.v_proj = nn.Linear(hidden_size, head_dim, bias=False)

    def forward(self, x):
        # x: [B, T, H]
        Q = self.q_proj(x)
        K = self.k_proj(x)
        V = self.v_proj(x)
        mask = make_causal_mask(T=x.size(1), device=x.device)
        output, weights = scaled_dot_product_attention(Q, K, V, mask)
        return output, weights



# 先看单头版的输出形状
single_head = SingleHeadSelfAttention(hidden_size=8, head_dim=4)
x = torch.randn(2, 6, 8)
output, weights = single_head(x)
print('single-head output shape  =', output.shape)
print('single-head weights shape =', weights.shape)



class MultiHeadSelfAttention(nn.Module):
    def __init__(self, hidden_size, num_heads):
        super().__init__()
        assert hidden_size % num_heads == 0
        self.hidden_size = hidden_size
        self.num_heads = num_heads
        self.head_dim = hidden_size // num_heads

        # 多头版里，q / k / v 仍然是线性层，只是一次性投到全部头的总维度
        self.q_proj = nn.Linear(hidden_size, hidden_size, bias=False)
        self.k_proj = nn.Linear(hidden_size, hidden_size, bias=False)
        self.v_proj = nn.Linear(hidden_size, hidden_size, bias=False)
        self.out_proj = nn.Linear(hidden_size, hidden_size, bias=False)

    def _split_heads(self, x):
        # [B, T, H] -> [B, h, T, d]
        B, T, H = x.shape
        x = x.view(B, T, self.num_heads, self.head_dim)
        return x.transpose(1, 2)

    def _merge_heads(self, x):
        # [B, h, T, d] -> [B, T, H]
        B, h, T, d = x.shape
        x = x.transpose(1, 2).contiguous()
        return x.view(B, T, h * d)

    def forward(self, x, need_weights=False):
        Q = self._split_heads(self.q_proj(x))
        K = self._split_heads(self.k_proj(x))
        V = self._split_heads(self.v_proj(x))

        mask = make_causal_mask(T=x.size(1), device=x.device)[None, None, :, :]
        output, weights = scaled_dot_product_attention(Q, K, V, mask)
        output = self.out_proj(self._merge_heads(output))
        return (output, weights) if need_weights else output



