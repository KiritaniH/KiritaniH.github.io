setwd("C:/Users/lenovo/Desktop/统计线性模型")
getwd()
df <- read.csv("6data.csv")
head(df)
fit <- lm(Y ~ X1 + X2 + X3 + X4, data = df)
summary(fit)
diag_tab <- df[, c("Y","X1","X2","X3","X4",
"stud_res","stud_del",
"leverage","dffits","cook")]
head(df)
stud_res  <- rstandard(fit)
# (ii) Studentized deleted residuals（external）
stud_del  <- rstudent(fit)
df$stud_res  <- stud_res
df$stud_del  <- stud_del
lev <- hatvalues(fit)
df$leverage <- lev
dff <- dffits(fit)
df$dffits <- dff
cook <- cooks.distance(fit)
df$cook <- cook
head(df)
diag_tab <- df[, c("Y","X1","X2","X3","X4",
"stud_res","stud_del",
"leverage","dffits","cook")]
write.csv(diag_tab, "q2_diagnostics.csv", row.names = FALSE)
head(diag_tab)
which(abs(df$stud_del) > 2)
p <- 5
n <- nrow(df)
crit_h <- 2*p/n
which(df$leverage > crit_h)
crit_dff <- 2 * sqrt(p/n)
which(abs(df$dffits) > crit_dff)
which(df$cook > 1)
